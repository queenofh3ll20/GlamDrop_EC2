# Esempio di inventario Ansible generato automaticamente da Terraform (terraform/inventory.tpl)
# Supporta sia l'accesso via AWS SSM Session Manager (senza porte aperte) che via IP/SSH.

[control_plane]
control-plane-1 ansible_host=i-0123456789abcdef0 ansible_user=ubuntu instance_id=i-0123456789abcdef0

[workers]
worker-1 ansible_host=i-0123456789abcdef1 ansible_user=ubuntu instance_id=i-0123456789abcdef1
worker-2 ansible_host=i-0123456789abcdef2 ansible_user=ubuntu instance_id=i-0123456789abcdef2

[k8s:children]
control_plane
workers

[all:vars]
aws_region=eu-south-1
project_name=glamdrop
ansible_ssh_private_key_file=../terraform/id_ed25519
ansible_ssh_common_args=-o ProxyCommand="aws ssm start-session --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p --region eu-south-1" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=60 -o ServerAliveInterval=15 -o ServerAliveCountMax=5
